# Bounded offline derivative of the reviewed immutable production relay image.
# The caller must verify its Config.User is exactly buzz:buzz before building.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
ARG EXPECTED_RELAY_SHA256
COPY buzz-relay /usr/local/bin/buzz-relay
RUN chmod 0755 /usr/local/bin/buzz-relay \
    && test -n "${EXPECTED_RELAY_SHA256}" \
    && printf '%s  %s\n' "${EXPECTED_RELAY_SHA256}" /usr/local/bin/buzz-relay | sha256sum --check --status \
    && ldd /usr/local/bin/buzz-relay > /tmp/buzz-relay-ldd.txt \
    && if grep -F 'not found' /tmp/buzz-relay-ldd.txt; then exit 1; else grep_status=$?; test "$grep_status" -eq 1; fi \
    && rm /tmp/buzz-relay-ldd.txt
USER buzz:buzz
# Keep the deployed frontend, command, environment, mounts and runtime identity.
