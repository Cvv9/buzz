# Built offline from the reviewed existing agent image and official npm
# tarballs verified against tinker-native-codex.lock.json before extraction.
# The Docker Engine legacy builder accepts the exact local immutable image ID.
FROM sha256:c206067f72c86185bf2e18d42c676c6c880a90759fd6e04b6e7977e417577426

USER root
RUN rm -rf -- /usr/local/lib/node_modules/@agentclientprotocol/codex-acp/node_modules/@openai/codex \
    /usr/local/lib/node_modules/@agentclientprotocol/codex-acp/node_modules/@openai/codex-linux-x64
COPY codex/ /usr/local/lib/node_modules/@agentclientprotocol/codex-acp/node_modules/@openai/codex/
COPY codex-linux-x64/ /usr/local/lib/node_modules/@agentclientprotocol/codex-acp/node_modules/@openai/codex-linux-x64/

RUN node /usr/local/lib/node_modules/@agentclientprotocol/codex-acp/node_modules/@openai/codex/bin/codex.js --version
# Entrypoint, command, all Rust binaries, ACP adapter, and runtime configuration
# are inherited unchanged. This candidate is scoped to Tinker only.
